<%= turbo_frame_tag 'app' do %>

    <section>
        <div class="site-container">
            <h1>Notifications</h1>
            <div class="notification-container">
                <% if @collab_requests.present? %>
                    <% @collab_requests.each do |r| %>
                        <div class="notification">
                            <%= render "collab_requests/preview", request: r %>
                            <%= button_to '', collab_requests_destroy_path(r.id), method: :delete, form_class: "btn-trash", title: "Delete" %>
                        </div>
                    <% end %>
                    <%= paginate @collab_requests %>
                <% end %>
                <% if @notifications.present? %>
                    <% if check_for_new_notifications %>
                        <%= button_to "Mark all as read", read_all_notifications_path, class: "read-all", data: {turbo_frame: '_top'} %>
                    <% end %>
                    <% @notifications.each do |n| %>
                        <div class="notification">
                            <% unless n.read %>
                                <%= button_to 'Mark as read', read_notification_path(n.id), method: :post, form_class: "btn-read" %>
                            <% end %>
                            <%= render "preview", notification: n  %>
                            <%= button_to '', notification_path(n.id), method: :delete, form_class: "btn-trash", title: "Delete message" %>
                        </div>
                    <% end %>
                    <%= paginate @notifications %>
                <% else %>
                    <p>You do not have any notifications</p>
                <% end %>
            </div>
        </div>
    </section>
<% end %>