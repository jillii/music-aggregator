<%= turbo_frame_tag "app" do %>
    <div id="about">
        <section>
            <div class="site-container">
                <h1>About Playlists With Friends</h1>
            </div>
        </section>
        <section>
            <div class="site-container">
                <h2>Make Playlists</h2>
                <p>Compile your favorite tracks to create the ultimate platlist. Listen ad-free.</p>
            </div>
        </section>
        <section>
            <div class="site-container">
                <h2>Collab With Friends</h2>
                <p>Invite friends to help curate your playlists.</p>
            </div>
        </section>
        <section>
            <div class="site-container">
                <h2>Login Or Register To Start</h2>
                <p>Feel free to listen to existing playlists, or login/register to create your own.</p>
                <div class="btn-container">
                    <%= link_to 'login', new_user_session_path, class: "btn menu-item", data: {turbo_frame: 'app'} %>
                    <%= link_to 'register', new_user_registration_path, class: "btn menu-item", data: {turbo_frame: 'app'} %>
                </div>
            </div>
        </section>
        <section>
            <div class="site-container">
                <h2>Questions or Comments</h2>
                <p>(Updated as of July 20 2025): This site is still under development, but should work. If you run into any issues, feel free to reach out at hello@jill.digital.</p>
                <p>Or check the issue queue to see if I'm already working on it: https://github.com/jillii/music-aggregator/issues</p>
            </div>
        </section>
    </div>
<% end %>