<%= turbo_frame_tag "app" do %>

<section class="playlist full">
  <div class="site-container">
    <div class="flexbox">
      <div class="pull-left">
        <% if @playlist.image.attached? %>
          <%= image_tag @playlist.image, size: "100x100", alt: "#{@playlist.title} image", class: "playlist-image"  %>
        <% end %>
        <div class="copy-area">
          <h1 class="playlist-title" data-toggle-original="edit-title"><%= @playlist.title %></h1>


          <% if @is_user %>
            <%= button_tag "Edit Title", class: "form-toggle", :'data-toggle' => "edit-title" %>
            <%= form_with(model: @playlist, html: {class: "form-togglable hidden", :'data-toggle-form' => "edit-title"}) do |form| %>
              <% if @playlist.errors.any? %>
                <div style="color: red">
                  <h2><%= pluralize(@playlist.errors.count, "error") %> prohibited this playlist from being saved:</h2>

                  <ul>
                    <% @playlist.errors.each do |error| %>
                      <li><%= error.full_message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
              <%= form.text_field :title, required: true %>
              <%= form.submit "Update" %>
              <%= button_tag "Cancel", type: :reset %>
            <% end %>
          <% end %>



          <%= render 'playlists/playlist-likes', playlist: @playlist %>
          <% if @is_user %>
            <p class="playlist-user">By you</p>
            <div class="playlist-actions">
                <%= button_to "", @playlist, method: :delete, form_class: "icon btn-trash", title: "Delete playlist", data: { turbo_confirm: "Are you sure?" } %>
                <%= button_tag "", class: "icon btn-replace-image form-toggle no-hide", title: "Replace image", :'data-toggle' => "replace-image" %>
                <%= link_to "", search_users_path, class: "icon btn-add-user", title: "Add friend" %>
              </div>

              <%= form_with(model: @playlist, html: {class: "form-togglable hidden", :'data-toggle-form' => "replace-image"}) do |form| %>
                <% if @playlist.errors.any? %>
                  <div style="color: red">
                    <h2><%= pluralize(@playlist.errors.count, "error") %> prohibited this playlist from being saved:</h2>

                    <ul>
                      <% @playlist.errors.each do |error| %>
                        <li><%= error.full_message %></li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>
                <div class="input-add-image">
                  <%= form.file_field :image, required: true, accept: "image/*", onchange: "loadFile(event)" %>
                  <img id="output" class="output" src=""/>
                </div>
                <p class="form-info">Image must be less than 1MB</p>
                <div class="form-error" id="image-error"></div>
                <%= form.submit "Update" %>
                <%= button_tag "Cancel", type: :reset %>
              <% end %>
          <% else %>
            <p class="playlist-user">
              By
              <%= link_to user_account_path(@user.id), class: 'playlist-user' do %>
                <%= @user.username ? @user.username : @user.email %>
              <% end %>
            </p>
          <% end %>
          <% if @playlist.editors.present? %>
            <div class="playlist-editors">
              # Editors
                <% @playlist.editors.each do |editor| %>
                  <div class="editor">
                    <%= link_to editor.username, user_account_path(editor) %>
                    <% if @is_user %>
                      <%= button_to "", {controller: :playlists, action: :delete_editor, editor_id: editor.id, id: @playlist.id}, method: :put, form_class: "btn-trash" %>
                    <% end %>
                    <% if current_user && current_user.id === editor.id %>
                      <%= button_to "Remove yourself", {controller: :playlists, action: :delete_editor, editor_id: editor.id, id: @playlist.id}, method: :put %>
                    <% end %>
                  </div>
                <% end %>
            </div>
          <% end %>
          <% unless @is_user || @is_editor %>
            <% if @collab_request_sent %>
              <%= button_tag 'Collab request sent', disabled: true, class: "btn" %>
            <% else %>
              <%= button_to 'Request Collab', collab_request_path(@playlist.id), class: "btn" %>
            <% end %>
          <% end %>
          <% if @playlist.tags.present? %>
            # Tags
            <div class="playlist-tags">
                <% @playlist.tags.each do |tag| %>
                    <%= render "tags/tag", tag: tag, is_user: @is_user %>
                <% end %>
            </div>
          <% end %>
          <% if @is_user %>
            <%= button_tag "Add Tags", class: "form-toggle", :'data-toggle' => "add-tags" %>
            <%= form_with(model: @playlist, html: {class: "form-togglable hidden", :'data-toggle-form' => "add-tags"}) do |form| %>
              <% if @playlist.errors.any? %>
                <div style="color: red">
                  <h2><%= pluralize(@playlist.errors.count, "error") %> prohibited this playlist from being saved:</h2>

                  <ul>
                    <% @playlist.errors.each do |error| %>
                      <li><%= error.full_message %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <%= form.label :tag_id, "Tags" %>
              <div id="tags" class="tag-list" name="playlist[tag_id]">
                <%= form.text_area :tag_id, class: "tags" %>
              </div>
              <%= form.hidden_field :tags, id: "tags-collector" %>

              <%= form.submit "Update" %>
              <%= button_tag "Cancel", type: :reset %>
            <% end %>
          <% end %>

        </div>
      </div><!-- pull-left -->
      <div class="pull-right">
        <% if @tracks.present? %>
            <% index = 0 %>
            <div class="playlist-actions">
              <%= button_to "", tracklists_create_path, params: {tracklist: { track_ids:  @tracks.map(&:id) }}, method: :post, id: "playPlaylist", class: "icon btn-play", title: "Play playlist", data: { turbo_frame: 'mediaplayer' } %>
              <%= button_to "", tracklists_edit_path, params: {id: current_user && current_user.tracklist ? current_user.tracklist.id : nil, tracklist: { track_ids:  @tracks.map(&:id) }}, method: :put, id: "cuePlaylist", class: "icon btn-load", title: "Add playlist to queue", data: { turbo_frame: 'mediaplayer', playlist: @track_ids.join(','), titles: @track_titles.join(',') } %>
            </div>

            <div id="<%= @is_user || @is_editor ? 'sortable-' : '' %>tracklist" class="playlist-track">
                <% for track in @tracks %>
                    <%= render "tracks/track", track: track, index: index, user: @user %>
                    <% index += 1 %>
                <% end %>
            </div>
        <% end %>

        <% if @is_user || @is_editor %>
            <%= link_to "Add track", add_track_path(@playlist), class: 'add-track' %>
        <% end %>
      </div><!-- pull-right -->
    </div><!-- .flexbox -->
  </div>
</section>
<% end%>
