<%= form_with(model: playlist) do |form| %>
  <% if playlist.errors.any? %>
    <div class="form-error">
      <h2><%= pluralize(playlist.errors.count, "error") %> prohibited this playlist from being saved:</h2>

      <ul>
        <% playlist.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form.label :title, "Playlist Title" %>
  <%= form.text_field :title, required: true %>

  <%= form.label :image, "Add an image" %>
  <div class="input-add-image">
    <%= form.file_field :image, required: true, accept: "image/*", onchange: "loadFile(event)" %>
    <img id="output" class="output" src=""/>
  </div>
  <p class="form-info">Image must be less than 1MB</p>
  <div id="image-error" class="form-error"></div>


  <%= form.label :tag_id, "Enter tags separated by commas" %>
  <%= form.text_area :tag_id, size: "40x5", placeholder: 'jazz, country, breakcore...' %><br>
  <%= form.submit %>
<% end %>

