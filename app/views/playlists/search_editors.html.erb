<%= turbo_frame_tag "app" do %>
<%= render 'shared/flash' %>
<section>
    <div class="site-container">
        <h1>
            <% if @search %>
                Search: users: <%= @search %>
            <% else %>
                Users
            <% end %>
        </h1>

        <%= render 'shared/search', path: add_editor_path %>

        <% if @users.present? %>
            <div class="add-editor-container">
                <% @users.each do |user| %>
                    <%= button_to "Add #{ user.username }", add_editor_path, params: {user: user.id}, method: :put, class: 'btn-add-editor' %>
                <% end %>
            </div>
            <%= paginate @users %>
        <% else %>
            <p>No users found.</p>
        <% end %>
    </div>
</section>
<% end %>